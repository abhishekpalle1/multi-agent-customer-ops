# Copy to .env and fill in real values locally. Never commit .env.
# Blank values are treated as unset.

# development | test. Destructive test-database setup requires APP_ENV=test
# (tasks.ps1 test / make test set it for the pytest process).
APP_ENV=development

# Development database (hosted PostgreSQL 17 + pgvector), session pooler, SSL required.
# Format: postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL=

# Separate test database used only by local integration tests and evals.
# Must never identify the same logical database as DATABASE_URL.
TEST_DATABASE_URL=

# Explicit opt-in for destructive integration-test setup (truncate/drop/reset)
# against TEST_DATABASE_URL. Only honoured when APP_ENV=test.
ALLOW_TEST_DATABASE_RESET=false

# Gemini model identifiers (configuration only; never hard-coded).
AGENT_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=

# Gemini API key. Live tests (-m live_llm) are skipped when unset.
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
